{
  "name": "kuroi-studio",
  "private": true,
  "version": "1.0.0",
  "description": "KUROI Studio — ブラウザで動くアバター＆3Dモデリングスタジオ。VRM / glTF / FBX / OBJ / STL / USDZ など多数の形式に出力。",
  "type": "module",
  "scripts": {
    "dev": "vite",
